// the version resource by numbers instead of winver.h (not on the cross build's resource path): 0x40004 =
// VOS_NT_WINDOWS32, 1 = VFT_APP. The manifest is a source of the target (CMake embeds it)
1 VERSIONINFO
FILEVERSION 6,0,0,0
PRODUCTVERSION 6,0,0,0
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "edplugin_common"
      VALUE "FileDescription", "A diagnosis for the plugins: the D3D11 runtime's method tables"
      VALUE "FileVersion", "6.0.0.0"
      VALUE "InternalName", "context_probe"
      VALUE "OriginalFilename", "context_probe.exe"
      VALUE "ProductName", "edplugin_common context_probe"
      VALUE "ProductVersion", "6.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
